# rates.db is NOT committed. It is a local build artefact, rebuilt from the CSV
# files under data/ with `python cli.py rebuild`. Committing a 9 MB SQLite
# binary through a browser upload corrupted it, and text survives git intact,
# is a twentieth of the size, and can be diffed.
rates.db
rates.db-wal
rates.db-shm
rates.db-journal

# Local run artefacts
update.log
bval_backfill.log
__pycache__/
*.pyc

# config.json is NOT excluded: it holds tolerances and thresholds only, no
# secrets. The PDEx API key lives in the PDEX_API_KEY environment variable
# locally, and in GitHub Actions secrets when hosted, so that nothing secret
# ever sits in this folder and the whole folder is safe to upload.
.streamlit/secrets.toml

# Backfill and run logs are working artefacts, never committed.
*.log
