# SQLite sidecar files. rates.db itself IS committed - it is the data the
# hosted dashboard reads - but the write-ahead log and shared-memory files are
# transient and must never be committed.
rates.db-wal
rates.db-shm
rates.db-journal

# Local run artefacts
update.log
bval_backfill.log
__pycache__/
*.pyc

# config.json is NOT excluded: it holds tolerances and thresholds only, no
# secrets. The PDEx API key lives in the PDEX_API_KEY environment variable
# locally, and in GitHub Actions secrets when hosted, so that nothing secret
# ever sits in this folder and the whole folder is safe to upload.
.streamlit/secrets.toml
