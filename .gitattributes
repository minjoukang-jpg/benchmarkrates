# Normalise text to LF in the repository.
* text=auto eol=lf

# The golden CSV fixtures are compared byte-for-byte by tests/test_contract.py,
# and export_csv emits LF. Git must never rewrite their line endings, or the
# contract test would fail on a Windows checkout for no real reason.
tests/golden/*.csv -text

# Windows shells need CRLF or they misparse.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The database is binary; never try to diff or convert it.
*.db binary
