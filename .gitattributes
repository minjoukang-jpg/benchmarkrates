# Normalise text to LF in the repository.
* text=auto eol=lf

# CSV data and fixtures are compared byte-for-byte and are written with LF.
# Git must never rewrite their line endings: the contract test would fail on a
# Windows checkout, and a rewritten seed file would not match its re-export.
tests/golden/*.csv -text
data/*.csv -text

# Windows shells need CRLF or they misparse.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The database is binary; never try to diff or convert it.
*.db binary
